# Public Supabase values. Safe to expose to the browser; RLS remains authoritative.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase Auth URL Configuration must allow:
# https://www.whatshappeninginai.com/auth/callback
# http://localhost:3000/auth/callback (local development only)

# Server/worker only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# AI Why Layer and chat moderation.
OPENAI_API_KEY=
OPENAI_WHY_MODEL=gpt-5-mini

# Optional public overrides for the managed PostHog client destination.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Worker: credential-free official sources are the safe default.
INGEST_SOURCES=hacker_news,github,google_trends
# Comma-separated official Google Trends RSS markets. Defaults to the supported
# global market set when omitted. GOOGLE_TRENDS_GEO remains a legacy fallback.
GOOGLE_TRENDS_GEOS=US,GB,CA,AU,IN,SG,JP,KR,DE,FR,TR,BR,MX,AR,ZA,NG,AE,SA,ID,PH,TH,VN,NZ,IT,ES,NL,PL,SE

# Optional official/provider APIs. Add the matching source to INGEST_SOURCES.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=whats-happening-trend-worker/1.0
X_BEARER_TOKEN=
X_WATCH_QUERIES=artificial intelligence,developer tools,climate technology
TAVILY_API_KEY=
EXA_API_KEY=
DISCOVERY_QUERY=breaking technology science culture trends today

# Local visual verification only. Never enable in production.
DEMO_MODE=false
